{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evrenverse/docx-tool/blob/main/src/docx_tool/schemas/doctor.schema.json",
  "title": "docx-tool doctor response",
  "type": "object",
  "required": ["schema_version", "tool", "tool_version", "status", "checks"],
  "properties": {
    "schema_version": {"const": "1"},
    "tool": {"const": "docx-tool"},
    "tool_version": {"type": "string"},
    "status": {"enum": ["ok", "degraded", "error"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "ok", "detail"],
        "properties": {
          "name": {"type": "string"},
          "required": {"type": "boolean"},
          "ok": {"type": "boolean"},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
